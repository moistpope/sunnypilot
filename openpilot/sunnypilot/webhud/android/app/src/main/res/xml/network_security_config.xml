<?xml version="1.0" encoding="utf-8"?>
<!-- The page is plain HTTP from the app's own relay on 127.0.0.1; the relay and the discovery probes
     use raw sockets, which this config doesn't govern. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
