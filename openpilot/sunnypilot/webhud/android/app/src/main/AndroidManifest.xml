<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:extractNativeLibs="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hud">

        <!-- rotating the screen keeps the page; a day/night switch recreates the activity so the
             page's prefers-color-scheme follows the car (the connection lives on in Link) -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android Automotive: stay usable while driving. Only honored for system apps or
                 allowlisted installers; see README -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- the head unit's media sessions and turn-by-turn notification, for the HUD's music and
             navigation cards; the app grants itself access through root (HudListener.grant) -->
        <service
            android:name=".HudListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
